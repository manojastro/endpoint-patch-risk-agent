# Patch Risk Sentinel configuration (copy to .env and adjust).
# docker compose reads .env automatically for ${VAR} interpolation; the
# uvicorn/dev path reads these via pydantic-settings.

# SQLite (default, zero setup) - relative to the backend working directory.
DATABASE_URL=sqlite:///./data/patch_risk.db
# PostgreSQL example (driver installed):
# DATABASE_URL=postgresql+psycopg://patch:patch@localhost:5432/patch_risk

# Simulated estate size (endpoints). 2500 default; use 300-800 on laptops.
ESTATE_SIZE=2500

# Deterministic simulation seed - same seed => identical fleet + outcomes.
SIM_SEED=1337

# LLM provider mode: "mock" (deterministic, offline) or "openai"
# (OpenAI-compatible endpoint; set OPENAI_BASE_URL / OPENAI_API_KEY too).
LLM_MODE=mock

# Ring stop thresholds: RING=threshold comma list (strictly-greater halts).
RING_FAILURE_THRESHOLDS=RING_0:0.10,RING_1:0.05,RING_2:0.03,RING_3:0.02,RING_4:0.02

# CORS origins allowed by the API (comma-separated), "*" to allow all.
CORS_ORIGINS=http://localhost:8014,http://127.0.0.1:8014

LOG_LEVEL=INFO
